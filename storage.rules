rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Membership comes from the familyId CUSTOM CLAIM, set by the server on
    // create-family / join-family (and lazily backfilled on any AI call /
    // /api/refresh-claims). This makes vault files per-family for EVERY
    // family, not just the seeded household.
    function inFamily(familyId) {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.familyId == familyId;
    }

    // Transition fallback: the original household accounts keep access to
    // THEIR OWN family's files even before their tokens carry the new claim.
    // Scoped to familyId == 'household' — no longer a master key to all families.
    function isLegacyHouseholdMember(familyId) {
      return familyId == 'household' &&
        request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'rorymclark@gmail.com',
          'partner@example.com',
          'child@example.com'
        ];
    }

    match /families/{familyId}/{allPaths=**} {
      allow read: if inFamily(familyId) || isLegacyHouseholdMember(familyId);
      // Size cap applies to uploads only. On delete, request.resource is null, so
      // gating delete on request.resource.size denied EVERY delete and orphaned files.
      allow create, update: if (inFamily(familyId) || isLegacyHouseholdMember(familyId))
        && request.resource.size < 20 * 1024 * 1024;
      allow delete: if inFamily(familyId) || isLegacyHouseholdMember(familyId);
    }

    // Everything else: locked.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
