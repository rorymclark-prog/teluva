rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // All app file operations use /api/files with current membership from the
    // named teluva-prod database. Cached custom claims never authorize bytes.
    // The Admin SDK gateway bypasses these client rules intentionally.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
