rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // The household: the Google accounts allowed into the shared family vault.
    // Add a new family member's email here to grant them access.
    function isFamilyMember() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'rorymclark@gmail.com',
          'partner@example.com',
          'child@example.com'
        ];
    }

    // Shared family vault — every authorised household account reads/writes the
    // same data (members, calendar, metadata, chat, drive index).
    match /families/{familyId}/{document=**} {
      allow read, write: if isFamilyMember();
    }

    // Legacy per-account paths (pre-sharing). Harmless to keep; lets anything a
    // single account saved before the switch still load for that account.
    match /users/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    match /users/{userId}/family_members/{memberId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    match /users/{userId}/calendar_events/{eventId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    match /users/{userId}/metadata/{docId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    match /users/{userId}/messages/{messageId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    match /users/{userId}/sharedDriveDocs/{docId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
  }
}
