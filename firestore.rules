rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything not explicitly matched below.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Helpers ─────────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isMemberOf(familyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/roles/$(request.auth.uid));
    }

    function roleIn(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/roles/$(request.auth.uid)).data.role;
    }

    function isAdminOf(familyId) {
      return isMemberOf(familyId) && roleIn(familyId) == 'admin';
    }

    // admin or member (not child) — can write shared lists and calendar
    function canWriteIn(familyId) {
      return isMemberOf(familyId) && roleIn(familyId) != 'child';
    }

    // ── User profiles ────────────────────────────────────────────────────────────

    // User profiles are written ONLY by the server (create/join endpoints with
    // the Admin SDK). A client that could write its own familyId/role could
    // walk into any family as admin — so it can't.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Self-update of harmless self-owned fields only — never familyId or role.
      // aiConsent is the user's own AI opt-in record (they own their consent).
      // AI-assistant chat history does NOT live here — see families/{familyId}/chat/{uid}
      // below. It used to be stored here (a single unscoped chatHistory field),
      // which meant it was shared across every space a login belonged to
      // (Family + any Business spaces) instead of being scoped per space —
      // switching spaces reused the SAME transcript, leaking the previous
      // space's conversation (and any AI edit cards referencing its members/
      // documents) into the new one. Legacy chatHistory fields on old docs are
      // simply orphaned now, not migrated.
      // tourSeenAt/interviewSeenAt/interviewStep: first-run tour and welcome
      // interview progress, self-owned and non-sensitive. Both callers
      // (tour.ts, interview.ts) already write with setDoc(...,{merge:true})
      // wrapped in a try/catch labelled "best-effort" — but omitting these
      // here didn't make the write skip quietly, it made it FAIL every time
      // (denied, not merged), so the tour/interview "seen" state never
      // actually persisted to Firestore and silently fell back to
      // localStorage only, defeating the whole point of storing it
      // server-side (surviving a reinstall / following the user cross-device).
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'email', 'aiConsent', 'tourSeenAt', 'interviewSeenAt', 'interviewStep']);
      // Admins can update the 'role' field on another member's profile
      allow update: if signedIn()
        && request.auth.uid != uid
        && isAdminOf(resource.data.familyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
      allow create, delete: if false;
    }

    // ── Families ─────────────────────────────────────────────────────────────────

    match /families/{familyId} {

      // Family metadata doc — MEMBERS ONLY. It carries the space's name and,
      // for a business space, its address and registration number, so a plain
      // `signedIn()` read let any Google account that guessed or was shown a
      // space id read those. The join flow does NOT need this rule: it reads
      // this doc SERVER-side with the Admin SDK (/api/join-family), which
      // bypasses rules entirely — so tightening it here costs the join flow
      // nothing. Every client-side reader (loadSpaceInfo, ImportantInfo,
      // FamilySettings) only ever runs for the active space, of which the
      // caller is by definition a member.
      //
      // `plan` ("free"/"paid") and `planExpiresAt` (its ISO expiry, or absent
      // for an indefinite grant) are EXCLUDED from client writes even for an
      // admin. Both are billing-authoritative and must only ever be set
      // server-side via the Admin SDK, which bypasses these rules. Without
      // this, a space's own admin could set plan:'paid' on themselves from
      // the browser console and defeat the AI-usage and seat-cap enforcement
      // entirely — and `planExpiresAt` needs the identical guard, not just
      // `plan`: once a trial has legitimately set plan:'paid', an unlisted
      // planExpiresAt would let the admin push their OWN expiry into the
      // future indefinitely from the client, turning a 14-day trial into a
      // permanent free grant without ever touching the guarded `plan` field
      // itself. The comparison errors (and so DENIES, failing closed) on a
      // client-side create that tries to set either — which is correct; the
      // info doc is only ever created server-side.
      match /info/{doc} {
        allow read: if isMemberOf(familyId);
        allow write: if isAdminOf(familyId)
          && (!('plan' in request.resource.data) || request.resource.data.plan == resource.data.plan)
          && (!('planExpiresAt' in request.resource.data) || request.resource.data.planExpiresAt == resource.data.planExpiresAt);
      }

      // Role assignments — one doc per uid. Created ONLY by the server
      // (create-family / join-family with the Admin SDK). Self-create would let
      // any signed-in stranger add themselves to any family — so it's closed.
      // This doc is the AUTHORITATIVE membership record — server-side auth
      // (requireMember) and isMemberOf() below both key off its existence, and
      // its `role` field is the only role anything trusts.
      //
      // DELETE is server-only (/api/remove-member). A client-side delete would
      // remove membership WITHOUT the three other things a removal has to do —
      // strip the space from users/{uid}.spaces[], re-point/clear their active
      // familyId, and re-mint their custom claims (which is what Storage rules
      // gate vault FILES on). A half-removed member keeps their file access and
      // is left pointing at a space they can no longer open.
      match /roles/{uid} {
        allow read:   if isMemberOf(familyId);
        allow create: if false;
        allow update: if isAdminOf(familyId);
        allow delete: if false;
      }

      // Family member profiles (name, medical, sizes, education, documents, etc.)
      // Actual collection name in Firestore is 'family_members' (not 'members')
      // Any adult (admin or member) can contribute family data; children are read-only.
      match /family_members/{memberId} {
        allow read:  if isMemberOf(familyId);
        allow write: if canWriteIn(familyId);
      }

      // Index docs: metadata/members (member ID list) and metadata/events (event ID list)
      // Written in the same batch as family_members / calendar_events respectively.
      match /metadata/{docId} {
        allow read: if isMemberOf(familyId);
        allow write: if canWriteIn(familyId);
      }

      // Calendar events
      // Actual collection name is 'calendar_events' (not 'calendar')
      match /calendar_events/{eventId} {
        allow read:  if isMemberOf(familyId);
        allow write: if canWriteIn(familyId);
      }

      // Reference documents — a single subcollection for all shared data docs:
      //   'info'       → contacts + reference numbers
      //   'household'  → address, wifi, vehicles, pets, utilities
      //   'finances'   → banks, insurance, benefits
      //   'timeline'   → family timeline
      //   'shopping'   → shopping list
      // All shared household data is writable by any adult (admin or member);
      // children are read-only. This is a family hub — members must be able to
      // contribute the address, assets, contacts, etc. they add via the AI chat.
      //
      // 'willsEstate' and 'willsAccess' are CARVED OUT of this rule and matched
      // separately below. The exclusion is load-bearing: Firestore ORs the
      // results of every rule whose path matches, so a stricter rule on
      // /reference/willsEstate does NOT override a permissive wildcard — it
      // just adds a second way in, and this one would keep granting every
      // member read. Excluding the names here is the only thing that makes the
      // rule below mean anything.
      function isProtectedReferenceDoc(docId) {
        return docId == 'willsEstate' || docId == 'willsAccess';
      }

      match /reference/{docId} {
        allow read:  if !isProtectedReferenceDoc(docId) && isMemberOf(familyId);
        allow write: if !isProtectedReferenceDoc(docId) && canWriteIn(familyId);
      }

      // Wills & estate — where the will is kept, who holds the signed original,
      // the notary, the executor, the "if something happens to me" letter.
      //
      // Until now this sat under the wildcard above, which meant EVERY member
      // could read it — including a teenager on a `member` role, since the
      // "children are read-only" distinction only ever governed WRITES. Rory
      // asked for this on 2026-08-20: "we should lock the will right? and give
      // access to certain people — i don't want the kids going through it".
      //
      // Admins always. Anyone else only if an admin has explicitly named them
      // in reference/willsAccess — which is the point of the feature: the
      // person you designate to handle your estate can be given the will
      // without being handed the whole vault, and nobody else in the family
      // gets it by default.
      //
      // Modelled on passwords/{pwId} below, which has had exactly this shape
      // since it shipped and is the precedent this document never got.
      //
      // canWriteIn(), not isMemberOf(): a CHILD is never a named reader, even
      // if their uid is on the list. That is not hypothetical — a teenager
      // granted access while on a `member` role and later moved to `child`
      // keeps their uid on the list, and without this clause the demotion
      // would silently leave the will open to them. Caught by the emulator
      // probe, not by the app: utils/willsAccess.ts already refused this case
      // client-side, which is exactly why the rule had to be checked
      // separately rather than inferred from the UI behaving correctly.
      function isNamedWillReader(familyId) {
        return canWriteIn(familyId)
          && exists(/databases/$(database)/documents/families/$(familyId)/reference/willsAccess)
          && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)/reference/willsAccess).data.get('readerUids', []);
      }

      match /reference/willsEstate {
        allow read:  if isAdminOf(familyId) || isNamedWillReader(familyId);
        allow write: if isAdminOf(familyId);
      }

      // The access list itself. Readable by any member so a granted person's
      // app can tell them they have access without asking an admin; writable
      // by admins ONLY — a list you can add yourself to is not an access list.
      // It holds uids and nothing else; names are resolved from roles/{uid},
      // which every member can already read.
      match /reference/willsAccess {
        allow read:  if isMemberOf(familyId);
        allow write: if isAdminOf(familyId);
      }

      // Asset inventory — any adult can add/edit; children read-only.
      match /assets/{assetId} {
        allow read:  if isMemberOf(familyId);
        allow write: if canWriteIn(familyId);
      }

      // Family passwords — ADMINS ONLY. Members and children cannot read or write.
      // All other vital info (member profiles, addresses, emergency contacts,
      // important numbers, household, calendar, assets) stays readable by every
      // member via isMemberOf above.
      match /passwords/{pwId} {
        allow read, write: if isAdminOf(familyId);
      }

      // Family chat messages. Any member reads; only writers (admin/member,
      // not child) post, and the sender is pinned to the caller's own uid so
      // nobody can post under another member's name. Messages are immutable;
      // only admins can delete.
      match /messages/{msgId} {
        allow read:   if isMemberOf(familyId);
        allow create: if canWriteIn(familyId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if false;
        allow delete: if isAdminOf(familyId);
      }

      // Shared Google-Drive document index (metadata only, no file bytes).
      match /sharedDriveDocs/{docId} {
        allow read:  if isMemberOf(familyId);
        allow write: if canWriteIn(familyId);
      }

      // AI-assistant chat history — one doc per member (doc id == their own
      // uid), scoped to THIS space so a Family-space conversation never
      // leaks into a Business space (or vice versa) for a login that belongs
      // to both. Distinct from /messages above, which is the shared family
      // chat feature — this is each member's own private AI transcript, so
      // only that member (not the whole family) may read or write their doc.
      match /chat/{uid} {
        allow read, write: if isMemberOf(familyId) && request.auth.uid == uid;
      }
    }
  }
}
