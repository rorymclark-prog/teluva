rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    match /users/{userId}/family_members/{memberId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    match /users/{userId}/calendar_events/{eventId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Ordered-ID metadata docs written by every save batch — without this rule
    // the atomic batch fails and nothing syncs.
    match /users/{userId}/metadata/{docId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Family chat, scoped per account (was a global /messages collection).
    match /users/{userId}/messages/{messageId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Drive sync index, scoped per account (was global /sharedDriveDocs).
    match /users/{userId}/sharedDriveDocs/{docId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
  }
}
