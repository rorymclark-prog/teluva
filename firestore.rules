rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything not explicitly matched below.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Helpers ─────────────────────────────────────────────────────────────────

    // Is the caller a verified, signed-in user?
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Does a roles doc exist for the caller in this family?
    function isMemberOf(familyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/roles/$(request.auth.uid));
    }

    // What is the caller's role in this family?
    function roleIn(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/roles/$(request.auth.uid)).data.role;
    }

    // Caller is admin of this family.
    function isAdminOf(familyId) {
      return isMemberOf(familyId) && roleIn(familyId) == 'admin';
    }

    // Caller is admin or member (not child) — can write shared lists and calendar.
    function canWriteIn(familyId) {
      return isMemberOf(familyId) && roleIn(familyId) != 'child';
    }

    // ── User profiles ────────────────────────────────────────────────────────────
    // Each user owns their own doc (chat history, displayName, familyId).
    // Admins may update the 'role' field on any profile within the same family
    // (used by setFamilyMemberRole when role change is saved via Family Settings).

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      allow update: if signedIn()
        && request.auth.uid != uid
        && isAdminOf(resource.data.familyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
    }

    // ── Families ─────────────────────────────────────────────────────────────────

    match /families/{familyId} {

      // Family metadata (name, createdAt, adminUid).
      match /info/{doc} {
        allow read: if isMemberOf(familyId);
        allow write: if isAdminOf(familyId);
      }

      // Role assignments — one doc per user uid.
      // Any signed-in user can create their OWN role doc (bootstrap on first login).
      // Only admins can change or remove roles.
      match /roles/{uid} {
        allow read:   if isMemberOf(familyId);
        allow create: if signedIn() && request.auth.uid == uid;
        allow update, delete: if isAdminOf(familyId);
      }

      // Family member profiles (name, medical, sizes, education, etc.).
      // All members can read; only admins can add, edit or delete.
      match /members/{memberId} {
        allow read:  if isMemberOf(familyId);
        allow write: if isAdminOf(familyId);
      }

      // Shared contacts (doctors, schools, friends).
      match /contacts/{contactId} {
        allow read:  if isMemberOf(familyId);
        allow write: if isAdminOf(familyId);
      }

      // Shared reference numbers (NI, tax, policy numbers).
      match /numbers/{numberId} {
        allow read:  if isMemberOf(familyId);
        allow write: if isAdminOf(familyId);
      }

      // Family calendar events.
      // All members can read; admin and member (not child) can add/edit/delete.
      match /calendar/{eventId} {
        allow read:  if isMemberOf(familyId);
        allow write: if canWriteIn(familyId);
      }

      // Reference documents:
      //   shopping  → anyone who isn't a child can add/check off items
      //   all others (vehicles, pets, utilities, banks, insurance, benefits) → admin only
      match /reference/{docId} {
        allow read: if isMemberOf(familyId);
        allow write: if docId == 'shopping'
          ? canWriteIn(familyId)
          : isAdminOf(familyId);
      }
    }
  }
}
