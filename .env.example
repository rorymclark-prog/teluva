# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_PICKER_API_KEY: created 2026-07-30, restricted to the Picker API
# and to this app's exact origins via HTTP referrer restrictions. Public by
# design (like VITE_GOOGLE_OAUTH_CLIENT_ID below) once restricted — it ships
# to every browser that loads the app either way, since the Picker widget
# needs it client-side. Left blank here on purpose: the real key is now
# HARDCODED as the default in src/utils/googleScopes.ts, not read from this
# file. `npm run build` runs inside a Cloud Build container that never
# receives a local .env — gcloud builds submit auto-derives a .gcloudignore
# from .gitignore when none exists, and .env* is gitignored, so a real .env
# file placed here would silently never reach the build. This var is kept as
# an override for anyone running a different deployment with its own key.
#
# To create a replacement (e.g. if this one is ever revoked):
#   gcloud alpha services api-keys create \
#     --project=gen-lang-client-0384516171 \
#     --display-name="Teluva Drive Picker (referrer-restricted, Picker API only)" \
#     --api-target=service=picker.googleapis.com \
#     --allowed-referrers="https://family-info-organizer-x3k4bua7pq-nw.a.run.app/*,https://family-info-organizer-1000796646145.europe-west2.run.app/*,http://localhost:3000/*"
# then paste the returned keyString into googleScopes.ts's hardcoded default.
VITE_GOOGLE_PICKER_API_KEY=""

# VITE_GOOGLE_OAUTH_CLIENT_ID: optional override for the OAuth client used by
# Google sign-in (src/utils/firebase.ts, src/utils/googleToken.ts). Falls back
# to the client Firebase auto-created for this project if unset — a client ID
# is public information, not a secret.
VITE_GOOGLE_OAUTH_CLIENT_ID=""
