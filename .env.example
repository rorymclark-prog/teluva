# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_PICKER_API_KEY: build-time only (read via import.meta.env, so it
# must exist when `npm run build` runs, e.g. present as a real .env file
# before `npm run deploy` / `gcloud builds submit`). A Google Cloud API key
# restricted to the Google Picker API and to this app's exact origin(s) via
# HTTP referrer restrictions — see src/utils/googleScopes.ts for why. Public
# by design (like VITE_GOOGLE_OAUTH_CLIENT_ID below) once restricted; not a
# secret to protect, just one to scope tightly.
#
# Until this is set, the app keeps requesting the broader drive.readonly
# scope and GoogleDriveSync.tsx keeps its existing folder browser — nothing
# breaks by leaving it unset. Setting it narrows the OAuth scope to
# drive.file and switches the UI to Google's own Picker widget instead.
#
# To create one:
#   gcloud alpha services api-keys create \
#     --project=gen-lang-client-0384516171 \
#     --display-name="Teluva Drive Picker (referrer-restricted, Picker API only)" \
#     --api-target=service=picker.googleapis.com \
#     --allowed-referrers="https://family-info-organizer-x3k4bua7pq-nw.a.run.app/*,https://family-info-organizer-1000796646145.europe-west2.run.app/*,http://localhost:3000/*"
# then read the key back with:
#   gcloud services api-keys list --project=gen-lang-client-0384516171
#   gcloud services api-keys get-key-string <KEY_NAME> --project=gen-lang-client-0384516171
VITE_GOOGLE_PICKER_API_KEY=""

# VITE_GOOGLE_OAUTH_CLIENT_ID: optional override for the OAuth client used by
# Google sign-in (src/utils/firebase.ts, src/utils/googleToken.ts). Falls back
# to the client Firebase auto-created for this project if unset — a client ID
# is public information, not a secret.
VITE_GOOGLE_OAUTH_CLIENT_ID=""
